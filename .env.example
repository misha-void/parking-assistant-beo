# Copy to .env and fill in OPENAI_API_KEY. Every other variable has a working default.

OPENAI_API_KEY=your_openai_api_key_here

# Milvus Lite, file-based and embedded (not MILVUS_URI - pymilvus reserves that name)
MILVUS_DB_PATH=./milvus_data/parking_assistant.db

# SQLite
DATABASE_URL=sqlite:///./parking_assistant.db

# Approval: true (default) lets the LLM approval agent decide, false waits for admin_app.py
AUTO_APPROVE=true

# Admin notification. With SMTP_* unset, the notification prints to the console instead.
ADMIN_EMAIL=admin@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=parking-assistant@example.com

# MCP recording service (Stage 3). The same key must be visible to the service and to
# whichever process confirms a reservation; both read this file.
MCP_SERVER_URL=http://localhost:8001
MCP_API_KEY=change-this-to-a-random-secret
MCP_RESERVATIONS_FILE=confirmed_reservations.txt

# Where per-turn chat logs are written
# CHAT_LOG_DIR=.logs
