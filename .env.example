# Environment variables for Parking Assistant

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default models
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Future: Vector DB configuration (when we add Milvus)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Milvus Lite Configuration (file-based, embedded)
MILVUS_DB_PATH=./milvus_data/parking_assistant.db

# Future: Database configuration (when we add SQLite/SQLAlchemy)
# DATABASE_URL=sqlite:///./parking_assistant.db

# SQLite Database (file-based)
DATABASE_URL=sqlite:///./parking_assistant.db

# Admin Approval Agent (second agent) - email notification config
# APP_BASE_URL is used to build confirm/refuse links sent to the admin
APP_BASE_URL=http://localhost:8000
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
# If SMTP_* vars are not set, notifications are printed to console instead.

# MCP Server (Stage 3) - processes confirmed reservations into file storage
MCP_SERVER_URL=http://localhost:8001
MCP_API_KEY=change-this-to-a-random-secret
MCP_RESERVATIONS_FILE=confirmed_reservations.txt
